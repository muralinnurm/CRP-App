{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "companyName": { "type": "string" },
        "jobTitle": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName"]
    },
    "clients": {
      "title": "Clients",
      "description": "Client directory items per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "companies": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatar_url": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["userId", "name"]
    },
    "projects": {
      "title": "Projects",
      "description": "Projects and monthly retainers per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "client_id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "expected_amount": { "type": "number" },
        "status": { "type": "string" },
        "billing_cycle_day": { "type": "number" },
        "due_date": { "type": "string" },
        "company_name": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["userId", "client_id", "title"]
    },
    "payments": {
      "title": "Payments",
      "description": "Payment records per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "client_id": { "type": "string" },
        "project_id": { "type": "string" },
        "amount": { "type": "number" },
        "payment_date": { "type": "string" },
        "payment_method": { "type": "string" },
        "reference_id": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["userId", "client_id", "project_id", "amount"]
    }
  }
}
